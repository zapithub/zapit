# ZAPIT — Environment Template
# Copy to .env and fill with real values. NEVER commit .env to git.
# See docs/ENV.md (Phase 5) for full reference. All *_SECRET and *_KEY values must be strong random strings (min 32 chars) in production.

# ── Core ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5500

# ── Database (Supabase) — REQUIRED ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Auth / Crypto — REQUIRED in production (strong random) ────
JWT_SECRET=                         # 32+ chars, e.g. openssl rand -hex 32
JWT_REFRESH_SECRET=                 # 32+ chars
ENCRYPTION_KEY=                     # 32+ chars, used for AES-256-CBC

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=zapit_webhook_secret_2024
SHARED_WA_NUMBER=                   # e.g. +2348012345678

# ── AI ─────────────────────────────────────────────────────────
HF_API_KEY=                         # Hugging Face
REPLICATE_API_KEY=                  # Replicate (Flux, Minimax)
OPENAI_API_KEY=                     # Fallback
UNSPLASH_ACCESS_KEY=

# ── Social OAuth ───────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Payments (Paystack) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Email (Brevo) ──────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=zapithub@gmail.com

# ── Admin (Phase 6.1 hardened) ────────────────────────────────
ADMIN_SECRET=                       # 32+ chars, header x-admin-secret (constant-time checked)
ADMIN_USERNAMES=admin               # reserved usernames (also blocks registration) — see RESERVED_USERNAMES
ADMIN_SEED_EMAIL=                   # optional: email to auto-promote to role='admin' after migration 20261002

# ── Hardening (Phase 6.1) ──────────────────────────────────────
# users.role is source of truth for admin (not username). After migration 20261002, run:
#   UPDATE users SET role='admin' WHERE email = 'ADMIN_SEED_EMAIL';
# SAFE_USER_SELECT excludes password_hash/otp — see src/utils/admin.js

# ── Optional ───────────────────────────────────────────────────
# All optional in dev; app warns if missing but still boots.
