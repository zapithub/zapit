# ZAPIT — Environment Template
# Copy to .env and fill with real values. NEVER commit .env to git.
# See docs/ENV.md (Phase 5) for full reference. All *_SECRET and *_KEY values must be strong random strings (min 32 chars) in production.

# ── Core ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5500

# ── Database (Supabase) — REQUIRED ─────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Auth / Crypto — REQUIRED in production (strong random) ────
JWT_SECRET=                         # 32+ chars, e.g. openssl rand -hex 32
JWT_REFRESH_SECRET=                 # 32+ chars
ENCRYPTION_KEY=                     # 32+ chars, used for AES-256-CBC

# ── WhatsApp (Meta Cloud API) ──────────────────────────────────
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=zapit_webhook_secret_2024
SHARED_WA_NUMBER=                   # e.g. +2348012345678

# ── AI ─────────────────────────────────────────────────────────
HF_API_KEY=                         # Hugging Face
REPLICATE_API_KEY=                  # Replicate (Flux, Minimax)
OPENAI_API_KEY=                     # Fallback
UNSPLASH_ACCESS_KEY=

# ── Social OAuth ───────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# ── Payments (Paystack) ────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Email (Brevo) ──────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=zapithub@gmail.com

# ── Admin ──────────────────────────────────────────────────────
ADMIN_SECRET=                       # 32+ chars, header x-admin-secret
ADMIN_USERNAMES=admin

# ── Optional ───────────────────────────────────────────────────
# All optional in dev; app warns if missing but still boots.
